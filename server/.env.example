# ==============================================
# RentalProof Backend Configuration
# ==============================================
NODE_ENV=production
PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/rentalproof?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters
JWT_EXPIRE=30d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
